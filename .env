# API base URL for the MVEC marketplace backend.
# Override locally without committing secrets.
#
# The backend listens on the PORT set in Mvec_backend/.env (3000 in this
# checkout; server.js falls back to 4000 when PORT is unset) and mounts every
# route under /api, so the /api suffix is required.
#
# `localhost` only works on the iOS simulator / desktop / web. On Android use
#   emulator : --dart-define=API_BASE_URL=http://10.0.2.2:3000/api
#   real device: --dart-define=API_BASE_URL=http://<your-LAN-ip>:3000/api
# A --dart-define always overrides this file.
API_BASE_URL=http://localhost:3000/api
