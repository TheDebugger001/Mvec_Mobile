# API base URL for the MVEC marketplace backend.
# Override locally without committing secrets.
#
# The backend (Mvec_backend/server.js) listens on PORT=4000 and mounts every
# route under /api, so the /api suffix is required.
#
# `localhost` only works on the iOS simulator / desktop / web. On Android use
#   emulator : --dart-define=API_BASE_URL=http://10.0.2.2:5000/api
#   real device: --dart-define=API_BASE_URL=http://<your-LAN-ip>:5000/api
# A --dart-define always overrides this file.
API_BASE_URL=http://localhost:5000/api
