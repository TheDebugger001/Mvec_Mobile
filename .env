# API base URL for the MVEC marketplace backend.
# Override locally without committing secrets.
#
# Local backend runs on port 4000 and mounts every route under /api.
#
# `localhost` only works on the iOS simulator / desktop / web. On Android use
#   emulator : --dart-define=API_BASE_URL=http://10.0.2.2:4000/api
#   real device: --dart-define=API_BASE_URL=http://<your-LAN-ip>:4000/api
# A --dart-define always overrides this file.
API_BASE_URL=http://localhost:4000/api
