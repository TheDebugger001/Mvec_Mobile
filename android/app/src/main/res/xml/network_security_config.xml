<?xml version="1.0" encoding="utf-8"?>
<!-- The hosted backend (api.ikiguzi.com) is HTTPS only, so nothing on the Android
     network stack may use plain HTTP. Debug builds can still reach a local
     backend over HTTP because Dart's HttpClient does not go through this config. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
